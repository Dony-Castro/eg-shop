<%- include('partials/header', { title }) %>
<% const formatDop = (value) => new Intl.NumberFormat('es-DO', { style: 'currency', currency: 'DOP' }).format(value); %>
<section class="card confirmation">
  <h1>¡Pedido registrado exitosamente!</h1>
  <p><strong>Número de pedido:</strong> #<%= order.id %></p>
  <p><strong>Cliente:</strong> <%= order.customer.fullName %></p>
  <p><strong>Correo:</strong> <%= order.customer.email %></p>
  <p><strong>Teléfono:</strong> <%= order.customer.phone %></p>
  <p><strong>Dirección:</strong> <%= order.customer.address %>, <%= order.customer.city %></p>
  <p><strong>Referencia:</strong> <%= order.customer.locationReference || 'N/A' %></p>
  <p><strong>Fecha:</strong> <%= new Date(order.createdAt).toLocaleString('es-DO') %></p>
  <p><strong>Estado:</strong> <%= order.status %></p>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>Producto</th>
          <th>Cantidad</th>
          <th>Precio unitario</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% order.items.forEach((item) => { %>
          <tr>
            <td><%= item.productName %></td>
            <td><%= item.quantity %></td>
            <td><%= formatDop(item.unitPrice) %></td>
            <td><%= formatDop(item.subtotal) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3"><strong>Total</strong></td>
          <td><strong><%= formatDop(order.total) %></strong></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="form-inline">
    <a class="btn" href="/">Volver al inicio</a>
    <a class="btn secondary" href="/">Realizar otro pedido</a>
  </div>
</section>
<script src="/js/confirmation.js"></script>
<%- include('partials/footer') %>
